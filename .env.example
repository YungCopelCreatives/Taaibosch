# GoDaddy: add these as the app's .env (environment variables) in the Node.js app dashboard.
# For local development copy this file to .env.local.

# ---- Website ----------------------------------------------------------------
# Leave out on Vercel test deployments.
SITE_URL="https://www.taaiboschorganic.co.za"

# ---- Dashboard login ---------------------------------------------------------
# Long random string that signs dashboard sessions. Never share it.
ADMIN_SESSION_SECRET=""
# The very first sign-in. When no team members exist yet, signing in at /admin
# with this email + password creates the Owner account. The owner is then asked
# to set up their profile and choose a new password. Remove both after that.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# ---- Database (Supabase) -----------------------------------------------------
# Supabase project > Project Settings > API. Run supabase/schema.sql once first.
# Without these, data is kept in ./.data, which is wiped on every deploy.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Payments (Yoco) ---------------------------------------------------------
# Yoco portal > Selling Online > Payment Gateway. Start with sk_test_..., go live with sk_live_...
YOCO_SECRET_KEY=""
# Optional: leave empty and use Dashboard > Settings > Payments > Connect Yoco instead.
# (Or set the value printed by: node scripts/register-yoco-webhook.mjs https://www.taaiboschorganic.co.za)
YOCO_WEBHOOK_SECRET=""

# ---- Emails (Resend) ---------------------------------------------------------
# resend.com: add and verify taaiboschorganic.co.za (it gives you DNS records to add in GoDaddy DNS).
RESEND_API_KEY=""
ORDER_FROM_EMAIL="orders@taaiboschorganic.co.za"
# Where new-order alerts go (defaults to the shop email set in Dashboard > Settings)
ORDER_NOTIFY_EMAIL=""
